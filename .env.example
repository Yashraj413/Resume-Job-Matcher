# Flask configuration
FLASK_ENV=development
SECRET_KEY=enter-a-long-random-secret-key-here

# Server Port
PORT=10000

# Database Configuration (Defaults to local SQLite)
# For Postgres on Render: postgresql://username:password@hostname:port/database
# DATABASE_URL=sqlite:///resume_matcher.db

# Gemini AI API Key (Optional: Unlocks AI ATS insights and recommendations)
GEMINI_API_KEY=your_gemini_api_key_here

# Security Limits
MAX_CONTENT_LENGTH=16777216  # 16 MB in bytes
